# Database connection string (SQLite file)
# In dev: sqlite:///./crm.db
# On Railway with persistent volume mounted at /app: sqlite:///./crm.db (or /data/crm.db)
DATABASE_URL=sqlite:///./crm.db

# Comma-separated allowed frontend origins for CORS
# In dev: http://localhost:5173
# In prod: http://localhost:5173,https://your-crm-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,https://your-crm-frontend.vercel.app
